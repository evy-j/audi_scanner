{
  "name": "@audit-scanner/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "admin:bootstrap": "tsx prisma/admin-bootstrap.ts",
    "billing:seed": "tsx prisma/billing-seed.ts",
    "build": "tsc -p tsconfig.json",
    "chain:seed": "tsx prisma/chain-registry-seed.ts",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed-free-beta.ts",
    "db:seed:dev": "tsx prisma/seed.ts",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@audit-scanner/shared": "*",
    "@prisma/client": "^6.5.0",
    "@types/node": "^20.17.24",
    "typescript": "^5.8.2",
    "prisma": "^6.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.24",
    "prisma": "^6.5.0",
    "typescript": "^5.8.2"
  }
}
