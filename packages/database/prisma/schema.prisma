model SecurityOsArtifact {
  id                 String                   @id @default(uuid()) @db.Uuid
  phase              SecurityOsDeepPhase
  artifactType       SecurityOsArtifactType    @map("artifact_type")
  organizationId     String?                  @map("organization_id") @db.Uuid
  projectId          String?                  @map("project_id") @db.Uuid
  scanId             String?                  @map("scan_id") @db.Uuid
  findingId          String?                  @map("finding_id") @db.Uuid
  sourceResourceType String?                  @map("source_resource_type") @db.VarChar(120)
  sourceResourceId   String?                  @map("source_resource_id") @db.VarChar(160)
  status             SecurityOsArtifactStatus @default(DRAFT)
  title              String                   @db.VarChar(240)
  summary            String?                  @db.Text
  policyStatus       String                   @default("REAL_ONLY") @map("policy_status") @db.VarChar(80)
  provenance         Json?
  evidenceRefs       Json?                    @map("evidence_refs")
  payload            Json?
  checksumSha256     String?                  @map("checksum_sha256") @db.VarChar(128)
  createdByUserId    String?                  @map("created_by_user_id") @db.Uuid
  lockedAt           DateTime?                @map("locked_at")
  expiresAt          DateTime?                @map("expires_at")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  @@index([phase, artifactType, status])
  @@index([organizationId, projectId, phase])
  @@index([scanId])
  @@index([findingId])
  @@map("security_os_artifacts")
}

model SecurityOsAuditRecord {
