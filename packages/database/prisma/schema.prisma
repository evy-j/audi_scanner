model User {
  id              String               @id @default(uuid()) @db.Uuid
  email           String?              @unique @db.VarChar(320)
  emailVerifiedAt DateTime?            @map("email_verified_at")
  passwordHash    String?              @map("password_hash") @db.VarChar(255)
  displayName     String?              @map("display_name") @db.VarChar(120)
  avatarUrl       String?              @map("avatar_url") @db.Text
  status          UserStatus           @default(PENDING)
  lastLoginAt     DateTime?            @map("last_login_at")
  metadata        Json?
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  deletedAt       DateTime?            @map("deleted_at")

  sessions        Session[]
  wallets         Wallet[]
  ownedOrganizations Organization[]    @relation("OrganizationOwner")
  memberships     OrganizationMember[]
  userRoles       UserRole[]           @relation("UserRoleUser")
  assignedRoles   UserRole[]           @relation("UserRoleAssignedBy")
  createdScans    Scan[]               @relation("ScanCreatedBy")
  reports         AuditReport[]        @relation("AuditReportCreatedBy")
  apiKeys         ApiKey[]             @relation("ApiKeyCreatedBy")
  auditLogs       AuditLog[]           @relation("AuditLogActor")
  teamMemberships TeamMember[]
  projectMemberships ProjectMember[]
  apiKeyAuditEvents ApiKeyAuditEvent[]  @relation("ApiKeyAuditActor")
  accessAuditLogs AccessAuditLog[]      @relation("AccessAuditActor")
  dataExportRequests DataExportRequest[] @relation("DataExportRequestedBy")
  dataDeletionRequests DataDeletionRequest[] @relation("DataDeletionRequestedBy")
  ssoLoginAttempts SsoLoginAttempt[]
  adminActionEvents AdminActionEvent[]  @relation("AdminActionActor")
  githubConnectedInstallations GitHubInstallation[] @relation("GitHubInstallationConnectedBy")
  githubConnectedRepositories GitHubRepository[] @relation("GitHubRepositoryConnectedBy")
  repositoryScans RepositoryScan[] @relation("RepositoryScanRequestedBy")
  ciRuns CiRun[] @relation("CiRunRequestedBy")
  cliScanEvents CliScanEvent[] @relation("CliScanRequestedBy")
  sourceArtifacts SourceArtifact[] @relation("SourceArtifactCreatedBy")
  sourceIngestionRuns SourceIngestionRun[] @relation("SourceIngestionRunCreatedBy")
  cliSourceUploads CliSourceUpload[] @relation("CliSourceUploadCreatedBy")

  @@index([status, createdAt])
  @@index([deletedAt])
  @@map("users")
}

model Wallet {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  chainId           String?  @map("chain_id") @db.Uuid
  address           String   @db.VarChar(128)
  normalizedAddress String   @map("normalized_address") @db.VarChar(128)
  nonceHash         String?  @map("nonce_hash") @db.VarChar(255)
  verifiedAt        DateTime? @map("verified_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chain             Chain?   @relation(fields: [chainId], references: [id], onDelete: SetNull)

  @@unique([normalizedAddress])
  @@index([chainId, normalizedAddress])
  @@index([userId])
  @@map("wallets")
}

model Session {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  refreshTokenHash String        @unique @map("refresh_token_hash") @db.VarChar(255)
  status           SessionStatus @default(ACTIVE)
  ipAddress        String?       @map("ip_address") @db.VarChar(64)
  userAgent        String?       @map("user_agent") @db.Text
  expiresAt        DateTime      @map("expires_at")
  revokedAt        DateTime?     @map("revoked_at")
  lastUsedAt       DateTime?     @map("last_used_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  deletedAt        DateTime?     @map("deleted_at")

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([expiresAt])
  @@map("sessions")
}

