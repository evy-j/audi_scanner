NODE_ENV=test
LOG_LEVEL=silent

TEST_POSTGRES_PORT=55432
TEST_REDIS_PORT=56379

DATABASE_URL=postgresql://audit_scanner:audit_scanner@localhost:55432/audit_scanner_test?schema=public
DIRECT_DATABASE_URL=postgresql://audit_scanner:audit_scanner@localhost:55432/audit_scanner_test?schema=public
REDIS_URL=redis://localhost:56379/15
REDIS_KEY_PREFIX=audit-scanner:test
TRUST_PROXY_HOPS=0
HTTP_REQUEST_TIMEOUT_MS=60000
HTTP_HEADERS_TIMEOUT_MS=65000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
HTTP_SHUTDOWN_GRACE_MS=5000
REALTIME_RATE_LIMIT_WINDOW_MS=60000
REALTIME_RATE_LIMIT_MAX_CONNECTIONS=100
SCAN_ADMISSION_MAX_QUEUED_JOBS=5000
ORG_CONCURRENCY_REQUEUE_DELAY_MS=1000
MONITORING_ENABLED=false
MONITORING_RPC_URL=
MONITORING_CHAIN_ID=
MONITORING_PROVIDER_NAME=test-rpc
MONITORING_POLL_INTERVAL_MS=30000
MONITORING_MAX_BLOCK_RANGE=100
MONITORING_REORG_DEPTH=6
MONITORING_MAX_EVENTS_PER_RUN=1000
MONITORING_WEBHOOKS_ENABLED=false

JWT_ACCESS_SECRET=test-access-secret-change-me-32chars
JWT_REFRESH_SECRET=test-refresh-secret-change-me-32chars
API_KEY_HASH_SECRET=test-api-key-secret-change-me-32chars

SCANNER_ARTIFACT_ROOT=.artifacts-test
SCANNER_TEMP_ROOT=.scanner-tmp-test
SCANNER_EXECUTION_MODE=container
SCANNER_DOCKER_BINARY=docker
SCANNER_DOCKER_PULL_POLICY=never
SCANNER_NETWORK_MODE=none
SCANNER_IPC_MODE=none
SCANNER_READ_ONLY_ROOT_FILESYSTEM=true
SCANNER_NO_NEW_PRIVILEGES=true
SCANNER_CONTAINER_USER=10001:10001
SCANNER_SECCOMP_PROFILE=./docker/security/seccomp-scanner.json

PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
PLAYWRIGHT_API_URL=http://127.0.0.1:4000/api/v1
PLAYWRIGHT_SKIP_WEB_SERVER=1

LOAD_TEST_TARGET=http://localhost:4000
LOAD_TEST_PATH=/health
LOAD_TEST_VUS=25
LOAD_TEST_DURATION_SECONDS=60
LOAD_TEST_MAX_ERROR_RATE=0.01
LOAD_TEST_P95_MS=500
