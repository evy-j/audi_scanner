# Host-side local development values.
# Docker Compose services use service DNS names internally; keep these localhost URLs for commands run from your host.

NODE_ENV=development
LOG_LEVEL=debug

WEB_PORT=3000
API_PORT=4000
POSTGRES_PORT=5432
REDIS_PORT=6379

API_BASE_PATH=/api/v1
TRUST_PROXY_HOPS=1
HTTP_REQUEST_TIMEOUT_MS=60000
HTTP_HEADERS_TIMEOUT_MS=65000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
HTTP_SHUTDOWN_GRACE_MS=15000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_REALTIME_WS_URL=ws://localhost:4000/api/v1/realtime
REALTIME_WS_PATH=/api/v1/realtime
REALTIME_RATE_LIMIT_WINDOW_MS=60000
REALTIME_RATE_LIMIT_MAX_CONNECTIONS=30
SCAN_ADMISSION_MAX_QUEUED_JOBS=5000
OUTBOX_RELAY_INTERVAL_MS=2000
OUTBOX_RELAY_BATCH_SIZE=25
OUTBOX_RELAY_MAX_ATTEMPTS=10

DATABASE_URL=postgresql://audit_scanner:audit_scanner@localhost:5432/audit_scanner?schema=public
DIRECT_DATABASE_URL=postgresql://audit_scanner:audit_scanner@localhost:5432/audit_scanner?schema=public
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=audit-scanner:local
REDIS_ENABLE_TLS=false
ORG_CONCURRENCY_REQUEUE_DELAY_MS=5000
MONITORING_ENABLED=false
MONITORING_RPC_URL=
MONITORING_CHAIN_ID=
MONITORING_PROVIDER_NAME=local-rpc
MONITORING_POLL_INTERVAL_MS=30000
MONITORING_MAX_BLOCK_RANGE=100
MONITORING_REORG_DEPTH=6
MONITORING_MAX_EVENTS_PER_RUN=1000
MONITORING_WEBHOOKS_ENABLED=false

JWT_ACCESS_SECRET=development-access-secret-change-me-32
JWT_REFRESH_SECRET=development-refresh-secret-change-me-32
API_KEY_HASH_SECRET=development-api-key-secret-change-me-32

DEV_SEED_EMAIL=dev@audit-scanner.local
DEV_SEED_PASSWORD=Development123!
DEV_SEED_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$397yGBjZ4MKIVD0o2Ha6kw$jL6h9i3hlQKXI0ZT/dXTlUzID5vxcMKHvlvv0FOiCww
DEV_SEED_ORG_SLUG=development-labs

LOCAL_SCAN_API_URL=http://localhost:4000/api/v1
LOCAL_SCAN_EMAIL=dev@audit-scanner.local
LOCAL_SCAN_PASSWORD=Development123!
LOCAL_SCAN_ORG_SLUG=development-labs
LOCAL_SCAN_SOURCE_DIR=examples/local-scan
LOCAL_SCAN_ARTIFACT_ROOT=.artifacts
LOCAL_SCAN_ARTIFACT_KEY=source-fixtures/local-scan
LOCAL_SCAN_ANALYZERS=semgrep
ARTIFACT_STORE_DRIVER=local
SCANNER_ARTIFACT_ROOT=.artifacts
SCANNER_TEMP_ROOT=.scanner-tmp

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FREE=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_YEARLY=
STRIPE_BILLING_PORTAL_RETURN_URL=http://localhost:3000/settings/billing
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000/settings/billing?checkout=success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000/settings/billing?checkout=cancel
BILLING_PAST_DUE_GRACE_DAYS=7
BILLING_USAGE_ROLLUP_INTERVAL_MS=3600000
