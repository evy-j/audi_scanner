# Web frontend environment. Public NEXT_PUBLIC values are safe to expose but must not contain secrets.

NODE_ENV=development
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_REALTIME_WS_URL=ws://localhost:4000/api/v1/realtime
NEXT_PUBLIC_WEB_BASE_URL=http://localhost:3000

# Staging/production should point to the deployed API and realtime origins.
# Example:
# NEXT_PUBLIC_API_BASE_URL=https://api-staging.example.com/api/v1
# NEXT_PUBLIC_REALTIME_WS_URL=wss://api-staging.example.com/api/v1/realtime
