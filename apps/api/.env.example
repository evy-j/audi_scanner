# API service environment. Use fake local values only; never commit real secrets.

NODE_ENV=development
LOG_LEVEL=info
PORT=4000
API_BASE_PATH=/api/v1
API_BASE_URL=http://localhost:4000/api/v1
WEB_BASE_URL=http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/audit_scanner?schema=public
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=audit-scanner
REDIS_ENABLE_TLS=false

CORS_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

JWT_SECRET=replace-me-minimum-32-characters-jwt-secret
JWT_ACCESS_SECRET=replace-me-minimum-32-characters-access-secret
JWT_REFRESH_SECRET=replace-me-minimum-32-characters-refresh-secret
API_KEY_HASH_SECRET=replace-me-minimum-32-characters-api-key-hash-secret
REPORT_SHARE_SECRET=replace-me-minimum-32-characters-report-share-secret

RATE_LIMIT_STORE=memory
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX_REQUESTS=20
SCAN_RATE_LIMIT_MAX_REQUESTS=30
ACTION_RATE_LIMIT_MAX_REQUESTS=20
REDIS_REQUIRED=false
QUEUE_BACKEND=auto
QUEUE_READY_STRICT=false
SINGLE_SERVICE_WORKER_ENABLED=false
SINGLE_SERVICE_WORKER_STRICT=false
REDIS_HEALTH_TIMEOUT_MS=2500
REDIS_CONNECT_FAMILY=0

FREE_BETA_SCANS_PER_MONTH=25
FREE_BETA_AI_VALIDATIONS_PER_MONTH=50
FREE_BETA_REMEDIATION_RUNS_PER_MONTH=25
FREE_BETA_REPORT_EXPORTS_PER_MONTH=25
FREE_BETA_MONITORED_PROJECTS=3

SIMULATION_ENABLED=false
SIMULATION_SAFETY_LEVEL=LOCAL_ONLY
SIMULATION_RPC_URL=
SIMULATION_MAX_DURATION_MS=30000
SIMULATION_MAX_OUTPUT_BYTES=1000000

FUZZING_ENABLED=false
FUZZING_SAFETY_LEVEL=LOCAL_ONLY
FUZZING_MAX_DURATION_MS=60000
FUZZING_MAX_OUTPUT_BYTES=1000000
FUZZING_DEFAULT_RUNS=256

# Billing and payment providers
# Disabled by default. Do not configure real credentials in committed files.
BILLING_ENABLED=false
BILLING_PROVIDER=DISABLED
BILLING_WEBHOOK_SECRET=
BILLING_SUCCESS_URL=http://localhost:3000/settings/billing?checkout=success
BILLING_CANCEL_URL=http://localhost:3000/settings/billing?checkout=cancel
BILLING_CURRENCY=INR
BILLING_TEST_MODE=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

AI_ENABLED=false
AI_PROVIDER=DISABLED
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=

STORAGE_DRIVER=local
LOCAL_ARTIFACT_DIR=.artifacts
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=

# P14 chain registry / multi-chain RPC references
# Raw RPC URLs should live only in deployment secret manager, never in database responses/logs.
ETHEREUM_MAINNET_RPC_URL=
POLYGON_MAINNET_RPC_URL=
BSC_MAINNET_RPC_URL=
ARBITRUM_ONE_RPC_URL=
OPTIMISM_MAINNET_RPC_URL=
BASE_MAINNET_RPC_URL=
AVALANCHE_C_CHAIN_RPC_URL=
SEPOLIA_RPC_URL=
ETHEREUM_MAINNET_EXPLORER_API_KEY=
POLYGON_MAINNET_EXPLORER_API_KEY=
BSC_MAINNET_EXPLORER_API_KEY=

# P14B explorer verification. Use chain-specific keys or the Etherscan V2 unified key.
ETHERSCAN_API_KEY=
ETHEREUM_MAINNET_EXPLORER_API_KEY=
POLYGON_MAINNET_EXPLORER_API_KEY=
BSC_MAINNET_EXPLORER_API_KEY=
BASE_MAINNET_EXPLORER_API_KEY=
ARBITRUM_ONE_EXPLORER_API_KEY=
OPTIMISM_MAINNET_EXPLORER_API_KEY=
AVALANCHE_C_CHAIN_EXPLORER_API_KEY=
