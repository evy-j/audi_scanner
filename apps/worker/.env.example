# Worker service environment. Use fake local values only; never commit real secrets.

NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/audit_scanner?schema=public
API_BASE_URL=http://localhost:4000/api/v1
WEB_BASE_URL=http://localhost:3000

REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=audit-scanner
REDIS_ENABLE_TLS=false
REDIS_HEALTH_TIMEOUT_MS=2500
REDIS_CONNECT_FAMILY=0
WORKER_REDIS_PREFLIGHT=true
SINGLE_SERVICE_WORKER_STRICT=false

WORKER_ID=
WORKER_HOSTNAME=
WORKER_HEARTBEAT_INTERVAL_MS=15000
WORKER_HEARTBEAT_TTL_MS=45000
JOB_LOCK_DURATION_MS=120000
JOB_STALLED_INTERVAL_MS=30000
JOB_MAX_STALLED_COUNT=2
QUEUE_EVENTS_MAX_LEN=10000
WORKER_QUEUE_EVENTS_ENABLED=false

STORAGE_DRIVER=local
LOCAL_ARTIFACT_DIR=.artifacts
ARTIFACT_STORE_DRIVER=local
SCANNER_ARTIFACT_ROOT=.artifacts
SCANNER_TEMP_ROOT=.scanner-tmp

S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=
ARTIFACT_S3_ENDPOINT=
ARTIFACT_S3_REGION=auto
ARTIFACT_S3_BUCKET=
ARTIFACT_S3_ACCESS_KEY_ID=
ARTIFACT_S3_SECRET_ACCESS_KEY=
ARTIFACT_S3_SESSION_TOKEN=
ARTIFACT_S3_PREFIX=
ARTIFACT_S3_FORCE_PATH_STYLE=true

AI_ENABLED=false
AI_PROVIDER=DISABLED
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
AI_REPORT_PROVIDER=disabled
AI_REPORT_BASE_URL=https://api.openai.com/v1
AI_REPORT_API_KEY=
AI_REPORT_MODEL=

REPORT_SHARE_SECRET=replace-me-minimum-32-characters-report-share-secret

SIMULATION_ENABLED=false
SIMULATION_SAFETY_LEVEL=LOCAL_ONLY
SIMULATION_RPC_URL=
SIMULATION_MAX_DURATION_MS=30000
SIMULATION_MAX_OUTPUT_BYTES=1000000

FUZZING_ENABLED=false
FUZZING_SAFETY_LEVEL=LOCAL_ONLY
FUZZING_MAX_DURATION_MS=60000
FUZZING_MAX_OUTPUT_BYTES=1000000
FUZZING_DEFAULT_RUNS=256

SCANNER_EXECUTION_MODE=container
SCANNER_DOCKER_BINARY=docker
SCANNER_DOCKER_PULL_POLICY=never
SCANNER_NETWORK_MODE=none
SCANNER_IPC_MODE=none
SCANNER_READ_ONLY_ROOT_FILESYSTEM=true
SCANNER_NO_NEW_PRIVILEGES=true
SCANNER_DISABLE_SWAP=true
SCANNER_TMPFS_NOEXEC=true
