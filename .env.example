# Web3Guard AI environment template.
# Copy to .env for local development, then replace every "replace-me" value before staging or production.
# Do not commit real secrets, private keys, API keys, database passwords, or production credentials.

# Runtime
NODE_ENV=development
LOG_LEVEL=info
PORT=4000
API_BASE_PATH=/api/v1
API_BASE_URL=http://localhost:4000/api/v1
WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_REALTIME_WS_URL=ws://localhost:4000/api/v1/realtime

# CORS
# Local: http://localhost:3000
# Staging/production: set exactly one deployed web origin. Wildcards are rejected in production.
CORS_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Database and Redis
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/audit_scanner?schema=public
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/audit_scanner?schema=public
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=audit-scanner
REDIS_ENABLE_TLS=false
REDIS_COMMAND_TIMEOUT_MS=10000

# Auth secrets
# Local placeholders are intentionally fake. Use 32+ random characters in staging/production.
JWT_SECRET=replace-me-minimum-32-characters-jwt-secret
JWT_ACCESS_SECRET=replace-me-minimum-32-characters-access-secret
JWT_REFRESH_SECRET=replace-me-minimum-32-characters-refresh-secret
API_KEY_HASH_SECRET=replace-me-minimum-32-characters-api-key-hash-secret
REPORT_SHARE_SECRET=replace-me-minimum-32-characters-report-share-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
PASSWORD_MIN_LENGTH=12

# Rate limits
RATE_LIMIT_STORE=memory
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX_REQUESTS=20
SCAN_RATE_LIMIT_MAX_REQUESTS=30
ACTION_RATE_LIMIT_MAX_REQUESTS=20
SCAN_ADMISSION_MAX_QUEUED_JOBS=5000
REDIS_REQUIRED=false
QUEUE_BACKEND=auto
QUEUE_READY_STRICT=false
SINGLE_SERVICE_WORKER_ENABLED=false
SINGLE_SERVICE_WORKER_STRICT=false
REDIS_HEALTH_TIMEOUT_MS=2500
REDIS_CONNECT_FAMILY=0

# FREE_BETA quota defaults
FREE_BETA_SCANS_PER_MONTH=25
FREE_BETA_AI_VALIDATIONS_PER_MONTH=50
FREE_BETA_REMEDIATION_RUNS_PER_MONTH=25
FREE_BETA_REPORT_EXPORTS_PER_MONTH=25
FREE_BETA_MONITORED_PROJECTS=3

# Local fork simulation
# Disabled by default. P7 never broadcasts live transactions and never accepts private keys.
SIMULATION_ENABLED=false
SIMULATION_SAFETY_LEVEL=LOCAL_ONLY
SIMULATION_RPC_URL=
SIMULATION_MAX_DURATION_MS=30000
SIMULATION_MAX_OUTPUT_BYTES=1000000

# Local fuzzing and invariant testing
# Disabled by default. P8 runs local/sandbox-only checks and never broadcasts transactions.
FUZZING_ENABLED=false
FUZZING_SAFETY_LEVEL=LOCAL_ONLY
FUZZING_MAX_DURATION_MS=60000
FUZZING_MAX_OUTPUT_BYTES=1000000
FUZZING_DEFAULT_RUNS=256

# Read-only on-chain monitoring
# Disabled by default. P9 never signs transactions, collects private keys, or runs mitigations.
MONITORING_ENABLED=false
MONITORING_RPC_URL=
MONITORING_CHAIN_ID=
MONITORING_PROVIDER_NAME=
MONITORING_POLL_INTERVAL_MS=30000
MONITORING_MAX_BLOCK_RANGE=100
MONITORING_REORG_DEPTH=6
MONITORING_MAX_EVENTS_PER_RUN=1000
MONITORING_WEBHOOKS_ENABLED=false

# GitHub App and CI/CD integration
# P12 remains inactive until real GitHub App credentials and installation are configured.
# Never commit real private keys, webhook secrets, client secrets, API keys, or installation tokens.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_NAME=

# Billing and payment providers
# Disabled by default. P13 never fabricates checkout, paid invoices, or entitlements.
BILLING_ENABLED=false
BILLING_PROVIDER=DISABLED
BILLING_WEBHOOK_SECRET=
BILLING_SUCCESS_URL=http://localhost:3000/settings/billing?checkout=success
BILLING_CANCEL_URL=http://localhost:3000/settings/billing?checkout=cancel
BILLING_CURRENCY=INR
BILLING_TEST_MODE=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Web3Guard CLI / GitHub Actions
# P12B CLI/CI scans upload sanitized source artifacts; legacy WEB3GUARD_SOURCE_ARTIFACT_KEY is optional.
WEB3GUARD_API_URL=http://localhost:4000/api/v1
WEB3GUARD_API_KEY=
WEB3GUARD_ORG_ID=
WEB3GUARD_PROJECT_ID=
WEB3GUARD_SOURCE_ARTIFACT_KEY=

# AI provider
# Leave disabled for staging until a provider key is intentionally configured.
AI_ENABLED=false
AI_PROVIDER=DISABLED
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
AI_MAX_TOKENS=2000
AI_TIMEOUT_MS=45000

# Storage
STORAGE_DRIVER=local
LOCAL_ARTIFACT_DIR=.artifacts
ARTIFACT_STORE_DRIVER=local
SCANNER_ARTIFACT_ROOT=.artifacts
SCANNER_TEMP_ROOT=.scanner-tmp

# S3/R2 placeholders only. Leave blank for local storage.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=
ARTIFACT_S3_ENDPOINT=
ARTIFACT_S3_REGION=auto
ARTIFACT_S3_BUCKET=
ARTIFACT_S3_ACCESS_KEY_ID=
ARTIFACT_S3_SECRET_ACCESS_KEY=
ARTIFACT_S3_SESSION_TOKEN=
ARTIFACT_S3_PREFIX=
ARTIFACT_S3_FORCE_PATH_STYLE=true

# API server tuning
TRUST_PROXY_HOPS=1
HTTP_REQUEST_TIMEOUT_MS=60000
HTTP_HEADERS_TIMEOUT_MS=65000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
HTTP_SHUTDOWN_GRACE_MS=15000
OUTBOX_RELAY_INTERVAL_MS=2000
OUTBOX_RELAY_BATCH_SIZE=25
OUTBOX_RELAY_MAX_ATTEMPTS=10

# Realtime
REALTIME_WS_PATH=/api/v1/realtime
REALTIME_HEARTBEAT_INTERVAL_MS=25000
REALTIME_MAX_SUBSCRIPTIONS_PER_CONNECTION=50
REALTIME_REPLAY_MAX_EVENTS=250
REALTIME_MAX_MESSAGE_BYTES=65536
REALTIME_MAX_BUFFERED_BYTES=1048576
REALTIME_RATE_LIMIT_WINDOW_MS=60000
REALTIME_RATE_LIMIT_MAX_CONNECTIONS=30

# Worker
WORKER_ID=
WORKER_HOSTNAME=
WORKER_HEARTBEAT_INTERVAL_MS=15000
WORKER_HEARTBEAT_TTL_MS=45000
JOB_LOCK_DURATION_MS=120000
JOB_STALLED_INTERVAL_MS=30000
JOB_MAX_STALLED_COUNT=2
QUEUE_EVENTS_MAX_LEN=10000
DEFAULT_ORG_CONCURRENCY=3
ORG_CONCURRENCY_LEASE_MS=120000
ORG_CONCURRENCY_REQUEUE_DELAY_MS=5000
SCANNER_EXECUTION_MODE=container
SCANNER_DOCKER_BINARY=docker
SCANNER_DOCKER_PULL_POLICY=never
SCANNER_NETWORK_MODE=none
SCANNER_IPC_MODE=none
SCANNER_READ_ONLY_ROOT_FILESYSTEM=true
SCANNER_NO_NEW_PRIVILEGES=true
SCANNER_DISABLE_SWAP=true
SCANNER_TMPFS_NOEXEC=true

# Admin bootstrap
# This must match an existing user email. The bootstrap script never creates a password.
ADMIN_EMAIL=

# P14 chain registry seed/use
# Run npm run chain:seed after migrations to seed supported chain metadata.
ETHEREUM_MAINNET_RPC_URL=
POLYGON_MAINNET_RPC_URL=
BSC_MAINNET_RPC_URL=
ARBITRUM_ONE_RPC_URL=
OPTIMISM_MAINNET_RPC_URL=
BASE_MAINNET_RPC_URL=
AVALANCHE_C_CHAIN_RPC_URL=
SEPOLIA_RPC_URL=

# P14B explorer verification. Use chain-specific keys or the Etherscan V2 unified key.
ETHERSCAN_API_KEY=
ETHEREUM_MAINNET_EXPLORER_API_KEY=
POLYGON_MAINNET_EXPLORER_API_KEY=
BSC_MAINNET_EXPLORER_API_KEY=
BASE_MAINNET_EXPLORER_API_KEY=
ARBITRUM_ONE_EXPLORER_API_KEY=
OPTIMISM_MAINNET_EXPLORER_API_KEY=
AVALANCHE_C_CHAIN_EXPLORER_API_KEY=
